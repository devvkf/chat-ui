{
  "name": "relay-chat-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "uv run --project backend uvicorn app.main:app --app-dir backend --reload --port 8000",
    "dev:all": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "start": "npm run build && uv run --project backend uvicorn app.main:app --app-dir backend --port 8000",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:ui": "node scripts/interact.mjs",
    "shoot": "node scripts/shoot.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.7",
    "@fontsource-variable/schibsted-grotesk": "^5.2.6",
    "@fontsource/instrument-serif": "^5.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.55.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
